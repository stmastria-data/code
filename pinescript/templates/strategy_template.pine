//
// Name:        <Strategy name>
// Version:     0.1.0
// Description: <Entry and exit rules in one or two sentences.>
// Notes:       Educational example. Not financial advice. Always forward-test.

//@version=6
strategy("NLT · <Strategy name>", shorttitle = "NLT <short>", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 1,
     process_orders_on_close = false)

// ─── Inputs ────────────────────────────────────────────────────────────────
grpRules = "Rules"
length   = input.int(20, "Length", minval = 1, group = grpRules)

grpRisk  = "Risk"
useStop  = input.bool(true, "Use stop loss", group = grpRisk)
stopPct  = input.float(2.0, "Stop loss %", minval = 0.1, step = 0.1, group = grpRisk)

// ─── Signals ───────────────────────────────────────────────────────────────
basis     = ta.sma(close, length)
longEntry = ta.crossover(close, basis)
longExit  = ta.crossunder(close, basis)

// ─── Orders ────────────────────────────────────────────────────────────────
if longEntry
    strategy.entry("Long", strategy.long)
if longExit
    strategy.close("Long")
if useStop and strategy.position_size > 0
    strategy.exit("Stop", "Long", stop = strategy.position_avg_price * (1 - stopPct / 100))

// ─── Plots ─────────────────────────────────────────────────────────────────
plot(basis, "Basis", color = color.orange)
